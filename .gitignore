# Gradle
.gradle/
# Anchored to each Gradle module's output dir, so it does not also match
# same-named directories inside src/ (DungeonPlugin has a `build` package).
/build/
/plugins/*/build/
**/gradle-user-home/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!plugins/classskills/gradle/wrapper/gradle-wrapper.jar
!plugins/classskills/gradle/wrapper/gradle-wrapper.properties

# IntelliJ
.idea/
*.iml
*.ipr
*.iws
out/

# Compiled
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
# ClassSkills requires this small precompiled Paper-26 dialog compatibility library.
!plugins/classskills/libs/classskills-dialog-prebuilt.jar

# OS
.DS_Store
Thumbs.db

# Logs
*.log
